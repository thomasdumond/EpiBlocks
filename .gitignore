# RStudio / R session files
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# Secrets and credentials: never commit these
.Renviron
.env
.env.*
.httr-oauth
.secrets/
*.pem
*.key
*.p12

# Deployment account info written by rsconnect
rsconnect/

# Local tools and OS files
.claude/
.DS_Store
Thumbs.db
desktop.ini

# renv: used locally only, not part of the app. The app runs on the server's
# own R packages (see README). Keeping .Rprofile out of the repo matters: on a
# server it would start renv and look for packages in an empty library.
.Rprofile
renv/
renv.lock
